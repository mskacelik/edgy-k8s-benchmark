ARG BASE_IMAGE=bench-base:dev

# BUILDPLATFORM: jars are architecture-independent, so the build stage runs
# natively even when the runtime stage targets another architecture.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/openjdk-21:1.24 AS build
USER root
WORKDIR /build
COPY .mvn .mvn
COPY mvnw pom.xml ./
# All three module poms: the aggregator cannot be read without them.
COPY backend-service/pom.xml backend-service/pom.xml
COPY edgy-gateway/pom.xml edgy-gateway/pom.xml
COPY scg-gateway/pom.xml scg-gateway/pom.xml
COPY backend-service/src backend-service/src
RUN microdnf install -y gzip && chmod +x mvnw
RUN --mount=type=cache,target=/root/.m2/repository \
    ./mvnw -pl backend-service package -DskipTests

FROM ${BASE_IMAGE}

COPY --from=build --chown=185 /build/backend-service/target/quarkus-app/lib/     /deployments/lib/
COPY --from=build --chown=185 /build/backend-service/target/quarkus-app/*.jar    /deployments/
COPY --from=build --chown=185 /build/backend-service/target/quarkus-app/app/     /deployments/app/
COPY --from=build --chown=185 /build/backend-service/target/quarkus-app/quarkus/ /deployments/quarkus/

ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
